#include<bits/stdc++.h>
using namespace std;
int main ()
{
 int n;
    long long factorial = 1;
    cout << "Type a number: ";
    cin >> n;
    if (n < 0) 
 {
        cout << "No negative numbers please." << endl;
 } else 
{
        for (int i = 1; i <= n; i++)
{
            factorial *= i;
 }
        cout << "Factorial of " << n << " = " << factorial << endl;}
    return 0;
}

